# Web origin (browser-facing). better-auth + tRPC talk to this; Next proxies to the API.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only: destination for the next.config rewrites (/api/auth, /trpc).
# Use 127.0.0.1 (not localhost) so Node's proxy fetch uses IPv4.
API_URL=http://127.0.0.1:8080

# Must match the API's BETTER_AUTH_SECRET so the edge middleware can verify the session cookie cache.
BETTER_AUTH_SECRET=
