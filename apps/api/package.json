{
  "name": "api",
  "version": "0.15.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:@aws-sdk/client-s3 --external:@trpc/server --external:better-auth --external:cors --external:dotenv --external:drizzle-orm --external:express --external:multer --external:postgres --external:zod",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/scripts/migrate.ts",
    "db:roles": "tsx src/db/scripts/roles.ts",
    "db:baseline": "tsx src/db/scripts/markBaseline.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx src/db/scripts/reset.ts",
    "db:seed": "tsx src/db/seeds/index.ts",
    "db:preflight": "tsx src/db/scripts/preflight.ts",
    "db:fresh": "pnpm db:preflight && pnpm db:reset && pnpm db:roles && pnpm db:migrate && pnpm db:seed --demo=local",
    "mt:verify": "tsx src/db/scripts/verifyMultitenant.ts",
    "tenant:create": "tsx src/db/scripts/createTenant.ts",
    "tenant:set-catalog-kind": "tsx src/db/scripts/tenantProfile.ts",
    "feature:list": "tsx src/db/scripts/feature.ts list",
    "feature:set": "tsx src/db/scripts/feature.ts set",
    "feature:unset": "tsx src/db/scripts/feature.ts unset",
    "jobs:event-reminders": "tsx src/jobs/scripts/runEventReminders.ts",
    "auth:generate": "better-auth generate --output src/db/schema/auth.ts --yes",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@repo/guards": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@trpc/server": "^11",
    "better-auth": "^1",
    "cors": "^2",
    "dotenv": "^16",
    "drizzle-orm": "^0.45",
    "express": "^5",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "postgres": "^3",
    "zod": "^4"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/multer": "^2.2.0",
    "drizzle-kit": "^0.31",
    "esbuild": "^0.25",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^4.1.11"
  }
}
