# Restricted "app" role (no SUPERUSER/BYPASSRLS): the API refuses to boot otherwise. A DATABASE_URL
# injected by the hosting provider is ignored: map it here by hand.
DATABASE_APP_URL=postgres://app:change-me@localhost:5432/mach_db
# Table owner / admin (must bypass RLS): db:roles, db:migrate, db:reset, db:baseline, db:studio, pg_dump.
# Local Docker: the compose admin user and database (mach_admin / mach_db).
DATABASE_OWNER_URL=postgres://mach_admin:change-me@localhost:5432/mach_db
# "platform" role (BYPASSRLS): db:seed, tenant:create, mt:verify.
DATABASE_PLATFORM_URL=postgres://platform:change-me@localhost:5432/mach_db
# db:roles creates the app and platform roles with the user and password of the two URLs above.
# Percent-encode reserved characters in passwords (@ : / % ? # ...), e.g. with encodeURIComponent.

BETTER_AUTH_SECRET=change-me-min-16-chars-long
BETTER_AUTH_URL=http://localhost:8080
# Comma-separated. Add your machine's LAN IP (e.g. http://192.168.1.x:3000) to test from a phone.
WEB_ORIGIN=http://localhost:3000
# Canonical web origin used to build password setup/reset links.
WEB_APP_URL=http://localhost:3000
PORT=8080

# Cloudflare R2 (S3-compatible). Ver apps/api/src/lib/storage/.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=mach-portal
R2_PUBLIC_URL=https://your-public-domain-or-r2-dev-url

# Microservicio Go de generación de PDF de cotizaciones (Function URL + API key,
# ver `terraform output function_url` y `pdf-quote-service/api-keys` en Secrets Manager).
PDF_SERVICE_URL=https://your-pdf-service-function-url
PDF_SERVICE_API_KEY=your-pdf-service-api-key

# Password de los usuarios sembrados por `db:seed` (solo desarrollo local).
SEED_PASSWORD=changeme123
