DATABASE_URL=postgres://app:app@localhost:5432/app
BETTER_AUTH_SECRET=change-me-min-16-chars-long
BETTER_AUTH_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000
PORT=8080

# Cloudflare R2 (S3-compatible). Ver apps/api/src/lib/storage/.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=mach-portal
R2_PUBLIC_URL=https://your-public-domain-or-r2-dev-url

# Password de los usuarios sembrados por `db:seed` (solo desarrollo local).
SEED_PASSWORD=changeme123
