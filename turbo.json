{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        ".next-prepush/**",
        "public/sw.js",
        "public/sw.js.map",
        "public/swe-worker-*.js"
      ],
      "env": ["API_URL", "NEXT_DIST_DIR"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "check-types": { "dependsOn": ["^check-types"] },
    "db:push": { "cache": false }
  }
}
