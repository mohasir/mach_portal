{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"], "env": ["API_URL"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "check-types": { "dependsOn": ["^check-types"] },
    "db:push": { "cache": false }
  }
}
